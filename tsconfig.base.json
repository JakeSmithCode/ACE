{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "baseUrl": ".",
    "paths": {
      "@ace/shared": ["packages/shared/src/index.ts"],
      "@ace/maps": ["packages/maps/src/index.ts"],
      "@ace/engine": ["packages/engine/src/index.ts"]
    }
  }
}
