{
  "name": "ace",
  "private": true,
  "version": "0.1.0",
  "description": "ACE — a persistent, player-run Valorant esports management simulation",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm --filter @ace/web dev",
    "navmesh": "tsx packages/maps/scripts/build-navmesh.ts ascent",
    "navmesh:all": "for m in abyss ascent bind breeze fracture haven icebox lotus pearl split sunset; do tsx packages/maps/scripts/build-navmesh.ts $m; done",
    "sim": "tsx packages/engine/src/cli.ts",
    "sim:check": "tsx packages/engine/src/check.ts",
    "balance": "tsx packages/engine/src/balance.ts",
    "balance:check": "tsx packages/engine/src/balance.ts --pool --check",
    "season": "tsx packages/world/src/cli.ts",
    "world": "tsx packages/world/src/cli-world.ts",
    "server": "tsx apps/server/src/cli.ts",
    "server:live": "tsx apps/server/src/http-demo.ts",
    "server:serve": "tsx apps/server/src/serve.ts",
    "typecheck": "turbo run typecheck",
    "server:pg": "tsx apps/server/src/pg-demo.ts",
    "server:pgsmoke": "bash infra/pg-smoke.sh"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "@types/node": "^22.10.2"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  }
}
